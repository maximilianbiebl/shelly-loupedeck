<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>

    <!-- Assembly Information -->
    <AssemblyName>ShellyLoupedeckPlugin</AssemblyName>
    <AssemblyTitle>Shelly Cloud Control Plugin</AssemblyTitle>
    <Product>Shelly Cloud Control</Product>
    <Description>Loupedeck plugin for Shelly Cloud device control</Description>
    <Company>Shelly Loupedeck Plugin</Company>
    <Copyright>Copyright © 2024</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>

    <!-- Loupedeck Installation Path - Adjust if your installation is elsewhere -->
    <LoupedeckInstallFolder Condition="'$(LoupedeckInstallFolder)' == '' And Exists('C:\Program Files\Loupedeck\Loupedeck2\')">C:\Program Files\Loupedeck\Loupedeck2\</LoupedeckInstallFolder>
    <LoupedeckInstallFolder Condition="'$(LoupedeckInstallFolder)' == '' And Exists('C:\Program Files (x86)\Loupedeck\Loupedeck2\')">C:\Program Files (x86)\Loupedeck\Loupedeck2\</LoupedeckInstallFolder>
    <LoupedeckInstallFolder Condition="'$(LoupedeckInstallFolder)' == ''">C:\Program Files\Loupedeck\Loupedeck2\</LoupedeckInstallFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loupedeck Plugin SDK - Referenced from local installation -->
    <Reference Include="PluginApi">
      <HintPath>$(LoupedeckInstallFolder)PluginApi.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LoupedeckPackage.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="metadata\Icon16x16.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="metadata\Icon256x256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
